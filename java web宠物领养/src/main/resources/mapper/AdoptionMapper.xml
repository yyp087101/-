<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.petadoption.mapper.AdoptionMapper">

    <resultMap id="adoptionDetailMap" type="com.petadoption.entity.Adoption">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="pet_id" property="petId"/>
        <result column="reason" property="reason"/>
        <result column="address" property="address"/>
        <result column="experience" property="experience"/>
        <result column="status" property="status"/>
        <result column="review_comment" property="reviewComment"/>
        <result column="reviewer_id" property="reviewerId"/>
        <result column="review_time" property="reviewTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <association property="user" javaType="com.petadoption.entity.User">
            <id column="u_id" property="id"/>
            <result column="u_username" property="username"/>
            <result column="u_realname" property="realname"/>
            <result column="u_phone" property="phone"/>
        </association>
        <association property="pet" javaType="com.petadoption.entity.Pet">
            <id column="p_id" property="id"/>
            <result column="p_name" property="name"/>
            <result column="p_type" property="type"/>
            <result column="p_breed" property="breed"/>
            <result column="p_image" property="image"/>
            <result column="p_status" property="status"/>
        </association>
    </resultMap>

    <select id="selectPageWithDetail" resultMap="adoptionDetailMap">
        SELECT a.*,
               u.id as u_id, u.username as u_username, u.realname as u_realname, u.phone as u_phone,
               p.id as p_id, p.name as p_name, p.type as p_type, p.breed as p_breed, p.image as p_image, p.status as p_status
        FROM adoption a
        LEFT JOIN user u ON a.user_id = u.id
        LEFT JOIN pet p ON a.pet_id = p.id
        <where>
            <if test="userId != null">AND a.user_id = #{userId}</if>
            <if test="status != null">AND a.status = #{status}</if>
        </where>
        ORDER BY a.create_time DESC
    </select>

    <select id="selectDetailById" resultMap="adoptionDetailMap">
        SELECT a.*,
               u.id as u_id, u.username as u_username, u.realname as u_realname, u.phone as u_phone,
               p.id as p_id, p.name as p_name, p.type as p_type, p.breed as p_breed, p.image as p_image, p.status as p_status
        FROM adoption a
        LEFT JOIN user u ON a.user_id = u.id
        LEFT JOIN pet p ON a.pet_id = p.id
        WHERE a.id = #{id}
    </select>

</mapper>
